{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "paths": { "@zhago/types": ["./src/types"] }
  },
  "include": ["src/**/*.ts", "modules/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["app", "build", "node_modules", ".gen"]
}
